{
  "cli": {
    "version": ">=18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "family": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
